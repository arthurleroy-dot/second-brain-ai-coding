# ---- LLM (chat) via proxy LiteLLM compatible Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Supabase — données applicatives UNIQUEMENT (chat) ----
# Le wiki vit dans git (markdown), jamais en base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- GitHub — dépôt des sources dans /raw + proxy des binaires ----
# PAT fine-grained limité à ce repo, permission "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main   # défaut : main

# ---- Protection d'accès (mot de passe partagé) ----
# Laisser vide en local = aucune protection. En prod, définir les deux.
SITE_PASSWORD=
SITE_SECRET=            # chaîne aléatoire longue (clé de signature du cookie)

# ---- Override des chemins wiki/raw (optionnel) ----
# Utile si le tracing Vercel ne résout pas ../wiki depuis process.cwd().
# WIKI_ROOT=/chemin/absolu/vers/wiki
# RAW_ROOT=/chemin/absolu/vers/raw
